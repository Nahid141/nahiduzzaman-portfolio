# Server-side environment variables for the PRRSLooM proxy routes (Vercel → Settings → Environment Variables).
# Both are optional: without them the proxy uses https://prrsloom-api.fnunahiduzzaman.com and no API key.
PRRSLOOM_BACKEND_URL=https://prrsloom-api.fnunahiduzzaman.com
# Must match PRRSLOOM_API_KEY in /etc/prrsloom/prrsloom.env when set
PRRSLOOM_API_KEY=
