# /etc/prrsloom/prrsloom.env  (root:prrsloom, mode 640). No secrets are committed.
# install.sh never overwrites an existing env file: apply changes to these values by hand.
PRRSLOOM_DATA_DIR=/srv/prrsloom

# --- capacity for a 4 vCPU / 16 GB VM ---------------------------------------------------
# Analyses running at once; more wait in the queue (FIFO, with queue position shown).
PRRSLOOM_MAX_WORKERS=2
# CPU threads shared by the running analyses: each job gets CPU_THREADS / MAX_WORKERS = 2
# (TIMER pair alignment and classifier re-alignment use them; BLAS/OpenMP/numba are capped
# to the same number so concurrent jobs never oversubscribe the 4 vCPUs).
PRRSLOOM_CPU_THREADS=4
PRRSLOOM_MAX_QUEUE=20
# Address-space limit per analysis process (RLIMIT_AS). Real use is lower (largest measured:
# ~0.6 GB RSS for a 3000-tip tree or a 150-sequence TIMER run); numba/LLVM reserve address
# space beyond what they touch. 2 jobs x 4 GB + API stays inside the unit's MemoryMax=10G.
PRRSLOOM_MEMORY_LIMIT_MB=4096
# Wall-clock limit per analysis. ClustalW (NJ Tree Builder) is the slowest step and is
# single-threaded: ~200 user sequences plus their references can exceed 30 minutes.
PRRSLOOM_JOB_TIMEOUT_S=3600
# Cached ClustalW/MAFFT alignments (identical inputs only), least recently used evicted first.
PRRSLOOM_ALIGNMENT_CACHE_MB=512
# -----------------------------------------------------------------------------------------

PRRSLOOM_RESULT_TTL_HOURS=72
PRRSLOOM_RESOURCE_TTL_HOURS=24
PRRSLOOM_CLUSTALW=clustalw
PRRSLOOM_MAFFT=mafft
NUMBA_CACHE_DIR=/srv/prrsloom/numba_cache
MPLCONFIGDIR=/srv/prrsloom/mplconfig
# Optional shared secret. If set here, set the same PRRSLOOM_API_KEY in Vercel (server-side env).
# PRRSLOOM_API_KEY=
