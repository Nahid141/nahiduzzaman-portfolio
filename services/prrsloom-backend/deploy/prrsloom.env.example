# /etc/prrsloom/prrsloom.env  (root:prrsloom, mode 640). No secrets are committed.
PRRSLOOM_DATA_DIR=/srv/prrsloom
PRRSLOOM_MAX_WORKERS=1
PRRSLOOM_MAX_QUEUE=20
PRRSLOOM_JOB_TIMEOUT_S=1800
PRRSLOOM_MEMORY_LIMIT_MB=3072
PRRSLOOM_RESULT_TTL_HOURS=72
PRRSLOOM_RESOURCE_TTL_HOURS=24
PRRSLOOM_CLUSTALW=clustalw
PRRSLOOM_MAFFT=mafft
NUMBA_CACHE_DIR=/srv/prrsloom/numba_cache
MPLCONFIGDIR=/srv/prrsloom/mplconfig
# Optional shared secret. If set here, set the same PRRSLOOM_API_KEY in Vercel (server-side env).
# PRRSLOOM_API_KEY=
